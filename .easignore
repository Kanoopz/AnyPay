# EAS Build ignore file
# This prevents EAS from including files outside the project directory

# Ignore everything outside project root
../

# System directories (macOS)
Library/
**/Library/
~/
~/*

# System files
*.log
*.diag
*.ips
*.wbt
*.zenc
*.csv
*.html
*.txt
# Don't ignore *.json - we need package.json and app.json!
*.zip
*.plist
*.duration

# Cache directories
**/cache*/
**/Cache*/
**/Caches/

# Diagnostic reports
**/DiagnosticReports/

# Application logs
**/Logs/

# Node modules
node_modules/

# Build artifacts
android/
ios/
.expo/
dist/
web-build/

# macOS specific
.DS_Store
.AppleDouble
.LSOverride

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
